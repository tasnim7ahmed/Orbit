<?xml version="1.0" encoding="utf-8"?>
<!--
  Orbit icon glyph: a phone with a watch orbiting it on a tilted ring.
  The ring's back half is drawn behind the phone, its front half over it.
  Everything sits inside the 66dp adaptive-icon safe zone (Wear masks to a circle).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ring, back half (behind the phone) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-25">
        <path
            android:pathData="M23,54 A31,11.5 0 1,1 85,54"
            android:strokeWidth="2.6"
            android:strokeColor="#8CFFFFFF"
            android:strokeLineCap="round" />
    </group>

    <!-- Phone shadow (vectors can't blur: two soft offset layers) -->
    <path
        android:fillColor="#1A0B1A4A"
        android:pathData="M48,33.4 H60 A7.6,7.6 0 0 1 67.6,41 V70.2 A7.6,7.6 0 0 1 60,77.8 H48 A7.6,7.6 0 0 1 40.4,70.2 V41 A7.6,7.6 0 0 1 48,33.4 Z" />
    <path
        android:fillColor="#240B1A4A"
        android:pathData="M48,33 H60 A7,7 0 0 1 67,40 V70 A7,7 0 0 1 60,77 H48 A7,7 0 0 1 41,70 V40 A7,7 0 0 1 48,33 Z" />

    <!-- Phone body -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M48,32 H60 A7,7 0 0 1 67,39 V69 A7,7 0 0 1 60,76 H48 A7,7 0 0 1 41,69 V39 A7,7 0 0 1 48,32 Z" />

    <!-- Screen -->
    <path android:pathData="M48.5,34.8 H59.5 A5,5 0 0 1 64.5,39.8 V68.2 A5,5 0 0 1 59.5,73.2 H48.5 A5,5 0 0 1 43.5,68.2 V39.8 A5,5 0 0 1 48.5,34.8 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="44"
                android:startY="35"
                android:endX="64"
                android:endY="73">
                <item android:offset="0" android:color="#FF3634A3" />
                <item android:offset="1" android:color="#FF0A6FD6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Dynamic Island -->
    <path
        android:fillColor="#FF0B0B1A"
        android:pathData="M51.3,37.2 H56.7 A1.3,1.3 0 0 1 56.7,39.8 H51.3 A1.3,1.3 0 0 1 51.3,37.2 Z" />

    <!-- Ring, front half + the orbiting watch -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-25">
        <path
            android:pathData="M23,54 A31,11.5 0 0,0 85,54"
            android:strokeWidth="2.6"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round" />

        <!-- Watch: white case with a blue face -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M79.4,60.6 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
        <path
            android:fillColor="#FF0A84FF"
            android:pathData="M79.4,60.6 m-3.6,0 a3.6,3.6 0 1,0 7.2,0 a3.6,3.6 0 1,0 -7.2,0" />
    </group>
</vector>
