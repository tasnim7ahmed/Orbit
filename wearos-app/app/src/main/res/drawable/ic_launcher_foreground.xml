<?xml version="1.0" encoding="utf-8"?>
<!--
  Orbit icon glyph: a glass planet (the iPhone) with a satellite (the watch) on a tilted
  ring, lit from the top left. The ring's back half is drawn behind the planet, its front
  half and the satellite over it. Everything sits inside the 66dp adaptive-icon safe zone.
  Keep in sync with master-docs/Orbit/orbit-icon.svg.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ring, back half: dims with depth -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-20">
        <path
            android:pathData="M24,54 A30,9.5 0 0,1 84,54"
            android:strokeWidth="3"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="0"
                    android:startY="54"
                    android:endX="0"
                    android:endY="44.5">
                    <item android:offset="0" android:color="#CCFFFFFF" />
                    <item android:offset="1" android:color="#47FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Planet: lit top-left, deep blue in shadow -->
    <path android:pathData="M37,54 a17,17 0 1,0 34,0 a17,17 0 1,0 -34,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="46"
                android:centerY="44"
                android:gradientRadius="26">
                <item android:offset="0" android:color="#FFA8DDFF" />
                <item android:offset="0.35" android:color="#FF3C9BFF" />
                <item android:offset="0.75" android:color="#FF1450C8" />
                <item android:offset="1" android:color="#FF0A2A78" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Cyan rim light -->
    <path android:pathData="M37,54 a17,17 0 1,0 34,0 a17,17 0 1,0 -34,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="17.5">
                <item android:offset="0.78" android:color="#0064D2FF" />
                <item android:offset="1" android:color="#8C64D2FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular highlight -->
    <group
        android:pivotX="47.5"
        android:pivotY="45.5"
        android:rotation="-35">
        <path android:pathData="M40.5,45.5 a7,4.4 0 1,0 14,0 a7,4.4 0 1,0 -14,0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="47.5"
                    android:centerY="45.5"
                    android:gradientRadius="7.5">
                    <item android:offset="0" android:color="#E6FFFFFF" />
                    <item android:offset="1" android:color="#00FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Ring, front half + the satellite riding it, just past the planet's edge -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-20">
        <path
            android:pathData="M24,54 A30,9.5 0 0,0 84,54"
            android:strokeWidth="3"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="0"
                    android:startY="54"
                    android:endX="0"
                    android:endY="63.5">
                    <item android:offset="0" android:color="#CCFFFFFF" />
                    <item android:offset="1" android:color="#FFFFFFFF" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M63.7,61.8 a7.5,7.5 0 1,0 15,0 a7.5,7.5 0 1,0 -15,0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="71.2"
                    android:centerY="61.8"
                    android:gradientRadius="7.5">
                    <item android:offset="0" android:color="#E6BFE6FF" />
                    <item android:offset="1" android:color="#00BFE6FF" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M67.8,61.8 a3.4,3.4 0 1,0 6.8,0 a3.4,3.4 0 1,0 -6.8,0" />
    </group>
</vector>
