<?xml version="1.0" encoding="utf-8"?>
<!--
  Orbit glyph for themed icons (alpha only): the planet with the ring cutting a gap through
  it, so the ring still reads in one colour, and the satellite on the ring.
  One even-odd path: planet + the ring's outer and inner edges. Inside the planet the band
  between them is cut out; outside the planet the same band is the visible ring.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-20">
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M37,54 a17,17 0 1,0 34,0 a17,17 0 1,0 -34,0 Z
                M22.5,54 a31.5,11 0 1,0 63,0 a31.5,11 0 1,0 -63,0 Z
                M25.5,54 a28.5,8 0 1,0 57,0 a28.5,8 0 1,0 -57,0 Z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M67.8,61.8 a3.4,3.4 0 1,0 6.8,0 a3.4,3.4 0 1,0 -6.8,0" />
    </group>
</vector>
